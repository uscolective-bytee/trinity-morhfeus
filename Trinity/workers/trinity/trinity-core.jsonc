{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trinity-core",
  "main": "../../services/core.js",
  "account_id": "b60342e5e52f5646fbd4e913bb409334",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "ai": {"binding": "AI"},
  "d1_databases": [{"binding":"DB","database_name":"trinity-v03","database_id":"ca8ea24e-f7db-431e-b8bf-97f713ae4533","migrations_dir":"../../migrations"}],
  "services": [{"binding":"KNOWLEDGE_SERVICE","service":"trinity-knowledge"},{"binding":"CONNECTORS","service":"trinity-connectors"}],
  "env": {
    "staging": {
      "name": "trinity-core-staging",
      "ai": {"binding": "AI"},
      "d1_databases": [{"binding":"DB","database_name":"trinity-development","database_id":"1cce5249-e044-4c93-868c-0df534a778b5","migrations_dir":"../../migrations"}],
      "services": [{"binding":"KNOWLEDGE_SERVICE","service":"trinity-knowledge"},{"binding":"CONNECTORS","service":"trinity-connectors"}]
    }
  }
